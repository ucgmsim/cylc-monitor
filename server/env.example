# Copy to .env (chmod 600) beside docker-compose.yml.
# Signs the API tokens and login cookies: changing it revokes every token.
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
DATASETTE_SECRET=
# The browser login (user `admin`), a datasette-auth-passwords hash, made on your own machine:
#   uvx --from datasette-auth-passwords==1.1.1 --with datasette==1.0a41 datasette hash-password
# Docker Compose reads $ in .env values literally only inside single quotes:
ADMIN_PASSWORD_HASH='pbkdf2_sha256$...'
